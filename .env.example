# ==============================================================================
# ENG PLANNER - Docker & Production Environment Configuration
# ==============================================================================

# Node Environment ('production' or 'development')
NODE_ENV=production
PORT=5005

# ------------------------------------------------------------------------------
# MySQL Database Configuration
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=eng_root_supersecret_change_me
MYSQL_DATABASE=eng_planner
MYSQL_USER=eng_user
MYSQL_PASSWORD=eng_db_password_change_me
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Prisma Database Connection String
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=mysql://eng_user:eng_db_password_change_me@mysql:3306/eng_planner

# Host Port Mappings (Ports exposed on host machine)
HOST_HTTP_PORT=80
HOST_DB_PORT=3306

# ------------------------------------------------------------------------------
# Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=generate-a-strong-random-secret-key-here-minimum-32-chars
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Optional AI Copilot (EngiAI)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your_google_gemini_api_key_here
