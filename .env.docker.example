# ==============================================================================
# ENG PLANNER - Docker Environment Configuration
# Copy this to .env before running: docker compose up -d --build
# ==============================================================================

NODE_ENV=production
PORT=5005

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=eng_root_supersecret_change_me
MYSQL_DATABASE=eng_planner
MYSQL_USER=eng_user
MYSQL_PASSWORD=eng_db_password_change_me
MYSQL_HOST=mysql
MYSQL_PORT=3306

DATABASE_URL=mysql://eng_user:eng_db_password_change_me@mysql:3306/eng_planner

# Host Port Mappings
HOST_HTTP_PORT=80
HOST_DB_PORT=3306

# Redis Cache
REDIS_URL=redis://redis:6379

# JWT Secret
JWT_SECRET=replace_this_with_a_secure_random_jwt_secret_key_512bits
JWT_EXPIRES_IN=7d

# Optional AI Copilot
# GEMINI_API_KEY=
